+/* Optional no-focus keyboard control surface used by dosbox-x-mcp.
+ *
+ * RegisterWindowMessage keeps the protocol out of the fixed WM_APP range,
+ * while the window property lets clients distinguish a patched build from a
+ * stock DOSBox-X before sending anything.  Messages are consumed on the main
+ * SDL event thread and enter the same KEYBOARD_AddKey path as mapper input. */
+static const char *const DOSBOX_MCP_KEYBOARD_MESSAGE =
+    "DOSBox-X MCP keyboard v1";
+static const char *const DOSBOX_MCP_KEYBOARD_PROPERTY =
+    "DOSBoxXMCPKeyboardV1";
+
+static UINT DOSBoxMCPKeyboardMessage(void) {
+    static const UINT message = RegisterWindowMessageA(DOSBOX_MCP_KEYBOARD_MESSAGE);
+    return message;
+}
+
+static void DOSBoxMCPKeyboardInit(void) {
+    SetPropA(GetHWND(), DOSBOX_MCP_KEYBOARD_PROPERTY, reinterpret_cast<HANDLE>(1));
+    DOSBoxMCPKeyboardMessage();
+}
+
+static bool DOSBoxMCPKeyboardHandle(UINT message, WPARAM key, LPARAM pressed) {
+    if (message != DOSBoxMCPKeyboardMessage()) return false;
+    if (key > KBD_NONE && key < KBD_LAST && (pressed == 0 || pressed == 1))
+        KEYBOARD_AddKey(static_cast<KBD_KEYS>(key), pressed != 0);
+    return true;
+}
+
 HWND GetSurfaceHWND(void) {
 # if defined(C_SDL2)
     return GetHWND();
